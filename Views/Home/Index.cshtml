<section id="form">
	<div class="container form-body">
		<div class="form-container">
			<h2 class="text-center mb-4">
				রেজিস্ট্রেশন ফরম
			</h2>
			<form action="#" method="POST" enctype="multipart/form-data">

				<div class="mb-3">
					<label for="name" class="form-label">নাম:</label>
					<input type="text" class="form-control" id="name" name="name" required>
				</div>

				<div class="mb-3">
					<label for="father_name" class="form-label">পিতার নাম:</label>
					<input type="text" class="form-control" id="father_name" name="father_name" required>
				</div>
				<div class="mb-3">
					<label for="phone" class="form-label">মোবাইল নম্বর:</label>
					<input type="tel" class="form-control" id="phone" name="phone" required>
				</div>

				<div class="mb-3">
					<label for="email" class="form-label">ই-মেইল:</label>
					<input type="email" class="form-control" id="email" name="email" required>
				</div>

				<div class="mb-3">
					<label class="form-label">আপনার এলাকা নির্বাচন করুন:</label>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="Haragach" name="area" value="Haragach" required>
						<label class="form-check-label" for="Haragach">হারাগাছ</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="Kaunia" name="area" value="Kaunia">
						<label class="form-check-label" for="Kaunia">কাউনিয়া</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="Pirgacha" name="area" value="Pirgacha">
						<label class="form-check-label" for="Pirgacha">পীরগাছা</label>
					</div>
				</div>

				<div class="mb-3">
					<label for="address" class="form-label">ঠিকানা:</label>
					<input type="text" class="form-control" id="address" name="address" required>
				</div>

				<div class="mb-3">
					<label for="college" class="form-label">শিক্ষা প্রতিষ্ঠানের নাম:</label>
					<input type="text" class="form-control" id="college" name="college" required>
				</div>

				<div class="mb-3">
					<label for="dob" class="form-label">জন্ম তারিখ:</label>
					<input type="date" class="form-control" id="dob" name="dob" required>
				</div>

				<div class="mb-3">
					<label class="form-label">
						যে বিষয়ে প্রতিযোগীতা করতে ইচ্ছুক
					</label>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="kirat" name="choice" value="kirat" required>
						<label class="form-check-label" for="kirat">কিরাত</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="hamdth" name="choice" value="hamdth">
						<label class="form-check-label" for="hamdth">হামদ-নাত</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" id="islamicGK" name="choice" value="islamicGK">
						<label class="form-check-label" for="islamicGK">ইসলামিক সাধারণজ্ঞান</label>
					</div>
				</div>

				<div class="mb-3">
					<label for="image" class="form-label">আপনার ছবি আপলোড করুন:</label>
					<input type="file" class="form-control" id="image" name="image" accept="image/*" required>
				</div>

				<button type="submit" class="btn btn-primary w-100">Pay with Bkash</button>
			</form>
		</div>
	</div>
</section>

