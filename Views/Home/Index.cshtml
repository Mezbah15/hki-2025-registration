@{
	ViewData["Title"] = "";
}
<head>
</head>
<button class="btn btn-info" style="margin-left: 200px; padding: 10px; ">Registration</button>
<marquee class="marquee-text" behavior="scroll" direction="left" scrollamount="8">
    📢 Important Notice: Registration is now open for the 2025 competition! 📢
</marquee>
<section class="container" style="text-align: center; background-color: #ffffff; position: relative;">
    <div id="heo-image"></div>
    <div style="position: absolute; top: 35%; left: 50%; transform: translate(-50%, -50%); width: 100%;">
        <h1 style="font-family: Calibri, sans-serif; color: white; font-size: 2em; margin: 0; line-height: 1.4;">
            হামদ-নাত, হিফজুল কোরআন
            <br />ও <br />
            ইসলামিক সাধারণজ্ঞান প্রতিযোগিতা - ২০২৫
        </h1>
    </div>
</section>
<div>
    <button class="btn btn-outline-info" style="margin: 50px 0 0 450px; padding:10px">আমাদের সম্পর্কে জানুন</button>
</div>
		
<div class="container">
    <h1 style="text-align: center; padding: 30px">ইসলামিক সাধারণজ্ঞান প্রতিযোগিতা - ২০২৫</h1>
	<div class="row">
        <img class="img-fluid" src="/Image/hki-poster.png" alt="Poster" />
	</div>
</div>
<div class="container">
	<div class="row">
		<div class="col">
           
        </div>
		<div class="col">
			<div>
				<h1 style="text-align: center; padding: 30px">অংশগ্রহণের নিয়মাবলী</h1>
			</div>
			<div>
				রেজিস্ট্রেশন: অংশগ্রহণের জন্য প্রথমে আমাদের ওয়েবসাইটে গিয়ে রেজিস্ট্রেশন ফর্ম পূরণ করুন।
				পরীক্ষার সময়: পরীক্ষার নির্ধারিত তারিখ ও সময় সঠিকভাবে জানিয়ে দেওয়া হবে, সুতরাং সঠিক সময়ে পরীক্ষা দিতে প্রস্তুত থাকুন।
				পরীক্ষার প্ল্যাটফর্ম: অনলাইন পরীক্ষা সম্পূর্ণ হবে নির্ধারিত প্ল্যাটফর্মে। তাই পরীক্ষার শুরু হওয়ার আগে প্ল্যাটফর্মটি পরীক্ষা করে নিন।
				বিষয়ভিত্তিক প্রস্তুতি: পরীক্ষায় অংশগ্রহণের পূর্বে ইসলামিক শিক্ষার মূল বিষয়গুলোর উপর প্রস্তুতি নিন।
				নিয়মাবলী:
				প্রশ্নপত্র: প্রতিটি পরীক্ষায় বিভিন্ন ধরনের প্রশ্ন থাকবে, যেমন এমসিকিউ, সঠিক/ভুল, এবং সৃজনশীল প্রশ্ন।
				পরীক্ষার সময়সীমা: পরীক্ষার জন্য নির্দিষ্ট সময়সীমা থাকবে, সেই সময়ে মধ্যে উত্তর জমা দিতে হবে।
				প্রতারণা বা অসৎভাবে উত্তরের চেষ্টা: কোনো ধরনের প্রতারণা বা অসৎ উপায়ে উত্তর দেওয়ার চেষ্টা করলে অংশগ্রহণকারীকে সরিয়ে দেওয়া হবে এবং পরবর্তী পরীক্ষার জন্য অযোগ্য ঘোষণা করা হবে।
				ফলাফল: পরীক্ষার ফলাফল নির্ভরযোগ্যভাবে মূল্যায়ন করা হবে এবং বিজয়ীদের পুরস্কৃত করা হবে।
				প্রথম ৩ স্থানের পুরস্কার: প্রথম তিনজন বিজয়ীকে আকর্ষণীয় পুরস্কার প্রদান করা হবে।
				শিক্ষক বা অভিভাবক: আপনি যদি ছাত্র হন তবে আপনার অভিভাবক বা শিক্ষককে আপনার পরীক্ষার অংশগ্রহণ বিষয়টি জানাতে হবে।
				বিজয়ীদের পুরস্কার:
				প্রথম স্থান: [বিশেষ পুরস্কার বা অর্থমূল্য]
				দ্বিতীয় স্থান: [বিশেষ পুরস্কার বা অর্থমূল্য]
				তৃতীয় স্থান: [বিশেষ পুরস্কার বা অর্থমূল্য]
			</div>
			<div>
				<button class="btn btn-outline-primary">Registration</button>
			</div>
		</div>
	</div>
</div>
<div class="container form-body">
    <div class="form-container">
        <h2 class="text-center mb-4">Submission Form</h2>
        <form action="#" method="POST" enctype="multipart/form-data">

            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <input type="text" class="form-control" id="name" name="name" required>
            </div>

            <div class="mb-3">
                <label for="father_name" class="form-label">Father's Name:</label>
                <input type="text" class="form-control" id="father_name" name="father_name" required>
            </div>

            <div class="mb-3">
                <label for="address" class="form-label">Address:</label>
                <input type="text" class="form-control" id="address" name="address" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Area:</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="urban" name="area" value="urban" required>
                    <label class="form-check-label" for="Haragach">Urban</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="suburban" name="area" value="suburban">
                    <label class="form-check-label" for="Kaunia">Suburban</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="rural" name="area" value="rural">
                    <label class="form-check-label" for="Pirgacha">Rural</label>
                </div>
            </div>

            <div class="mb-3">
                <label for="college" class="form-label">Institute Name:</label>
                <input type="text" class="form-control" id="college" name="college" required>
            </div>

            <div class="mb-3">
                <label for="dob" class="form-label">Date of Birth:</label>
                <input type="date" class="form-control" id="dob" name="dob" required>
            </div>

            <div class="mb-3">
                <label class="form-label">Choose an Option:</label>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="option1" name="choice" value="option1" required>
                    <label class="form-check-label" for="option1">হামদ-নাত</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="option2" name="choice" value="option2">
                    <label class="form-check-label" for="option2">হিফজুল কোরআন</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" id="option3" name="choice" value="option3">
                    <label class="form-check-label" for="option3">ইসলামিক সাধারণজ্ঞান</label>
                </div>
            </div>

            <div class="mb-3">
                <label for="phone" class="form-label">Phone:</label>
                <input type="tel" class="form-control" id="phone" name="phone" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload Image:</label>
                <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
            </div>

            <button type="submit" class="btn btn-primary w-100">Pay Now</button>
        </form>
    </div>
</div>

<div class="container">
    <div class="image-box mt-5">
        <h2 class="text-white">Welcome to Our Stylish Section</h2>

    </div>
</div>