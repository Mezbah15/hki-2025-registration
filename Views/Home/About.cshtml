@{
	ViewData["Title"] = "About Us";
}
<marquee class="marquee-text" behavior="scroll" direction="left" scrollamount="10">
	সাহাল ইবনে সা'দ রাদিয়াল্লাহু আনহু হতে বর্ণিত, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম (খায়বার যুদ্ধের সময়) আলী রাদিয়াল্লাহু আনহু-কে সম্বোধন করে বললেন, “আল্লাহর শপথ! তোমার দ্বারা একটি মানুষকেও যদি আল্লাহ সৎপথ দেখান, তবে তা (আরবের মহামূল্যবান) লাল উঁটনী অপেক্ষা উত্তম হবে।” (সহীহুল বুখারী ২৯৪২, মুসলিম ২৪০৬, আবূ দাউদ ৩৬৬১, আহমাদ ২২৩১৪)
</marquee>

<section class="container custom-section">
	<div class="row justify-content-center">
		<h4 style="margin:20px">
			আমাদের সম্পর্কে জানুন
		</h4>
		<div class="col-md-10">
			<img class="img-fluid" src="/Image/hki-poster.webp" alt="Poster">
		</div>
	</div>
</section>
