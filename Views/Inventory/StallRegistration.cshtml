@model hki_2025_registration.Models.ShopKeeper

@{
    ViewData["Title"] = "StallRegistration";
}

<section>
    <div class="container form-body">
        <div class="form-container">
            <h2 class="text-center mb-4">
                স্টল রেজিস্ট্রেশন ফরম
            </h2>
            <form asp-action="StallRegistration" asp-controller="Inventory" method="POST">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="control-label">নাম:</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Contact" class="control-label">মোবাইল নম্বর:</label>
                    <input asp-for="Contact" class="form-control" />
                    <span asp-validation-for="Contact" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="control-label">ঠিকানা:</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="control-label">
                        স্টলের ধরন
                    </label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Submit</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
