@using hki_2025_registration.PaginationHelper
@model PaginatedList<hki_2025_registration.Models.Participant>

@{
    ViewData["Title"] = "Index";
}
<div class="container">
    <div>
        <a asp-action="StallReg1578" class="btn btn-outline-primary">List of Stall Request</a>
    </div>
    <h3 style="margin-left: 30rem; color:darkcyan"> List of Participant</h3>
</div>

<table class="table table-hover table-responsive table-bordered">
    <thead>
        <tr>
            <th>
                Column Number
            </th>
            <th>
                Area
            </th>
            <th>
                Contest Department
            </th>
            <th>
                Payment Status
            </th>
            <th>
               Name
            </th>
            <th>
                Father Name
            </th>
            <th>
                Date of Birth
            </th>
            <th>
               Phone Number
            </th>
            <th>
                Address
            </th>
            <th>
               Education Institute
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var participant in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => participant.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Area)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Choice)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.PaymentStatus)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.FatherName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.DoB)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Contact)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => participant.Institute)
                </td>
              @*   <td>
                    <img src="~/Images/@participant.Image" style="height: 100px; width: 100px; border:solid 1px; border-color: gray" />
                </td> *@
            </tr>
        }
    </tbody>
</table>

@* Paging *@
@{
    var prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    var nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<a asp-action="PartiCipant1318" asp-route-pageIndex="@(Model.PageIndex > 1 ? Model.PageIndex - 1 : 1)"
   class="btn btn-outline-primary @prevDisabled">
    Previous
</a>

<a asp-action="PartiCipant1318" asp-route-pageIndex="@(Model.PageIndex + 1)"
   class="btn btn-outline-primary @nextDisabled">
    Next
</a>